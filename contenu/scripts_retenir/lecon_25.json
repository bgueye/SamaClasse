[
  {"lang": "fr-FR", "texte": "Anglais, classe de seconde L. À retenir : les temps du parfait."},
  {"lang": "en-GB", "texte": "The perfect tenses."},
  {"lang": "fr-FR", "texte": "Le premier temps :"},
  {"lang": "en-GB", "texte": "the present perfect simple."},
  {"lang": "fr-FR", "texte": "On le forme avec"},
  {"lang": "en-GB", "texte": "have"},
  {"lang": "fr-FR", "texte": "ou"},
  {"lang": "en-GB", "texte": "has,"},
  {"lang": "fr-FR", "texte": "suivi du participe passé. Par exemple :"},
  {"lang": "en-GB", "texte": "I have gone. She has gone."},
  {"lang": "fr-FR", "texte": "Il a quatre emplois. D'abord, une action récente, avec"},
  {"lang": "en-GB", "texte": "just."},
  {"lang": "fr-FR", "texte": "Ensuite, une action commencée dans le passé qui dure, avec"},
  {"lang": "en-GB", "texte": "since"},
  {"lang": "fr-FR", "texte": "ou"},
  {"lang": "en-GB", "texte": "for."},
  {"lang": "fr-FR", "texte": "Puis, une action passée aux conséquences visibles. Enfin, une expérience de vie, avec"},
  {"lang": "en-GB", "texte": "ever, never, already, yet."},
  {"lang": "fr-FR", "texte": "On emploie"},
  {"lang": "en-GB", "texte": "for"},
  {"lang": "fr-FR", "texte": "avec une durée, par exemple"},
  {"lang": "en-GB", "texte": "for 17 years."},
  {"lang": "fr-FR", "texte": "On emploie"},
  {"lang": "en-GB", "texte": "since"},
  {"lang": "fr-FR", "texte": "avec un point de départ, par exemple"},
  {"lang": "en-GB", "texte": "since 2009."},
  {"lang": "fr-FR", "texte": "Le deuxième temps :"},
  {"lang": "en-GB", "texte": "the present perfect continuous."},
  {"lang": "fr-FR", "texte": "On le forme avec"},
  {"lang": "en-GB", "texte": "have"},
  {"lang": "fr-FR", "texte": "ou"},
  {"lang": "en-GB", "texte": "has, been,"},
  {"lang": "fr-FR", "texte": "puis le verbe avec la terminaison"},
  {"lang": "en-GB", "texte": "ing."},
  {"lang": "fr-FR", "texte": "Il exprime une action commencée dans le passé qui continue, et il insiste sur la durée."},
  {"lang": "fr-FR", "texte": "Les verbes d'état n'ont pas de forme continue. On dit"},
  {"lang": "en-GB", "texte": "I have known,"},
  {"lang": "fr-FR", "texte": "et non"},
  {"lang": "en-GB", "texte": "I have been knowing."},
  {"lang": "fr-FR", "texte": "Le troisième temps :"},
  {"lang": "en-GB", "texte": "the past perfect simple."},
  {"lang": "fr-FR", "texte": "On le forme avec"},
  {"lang": "en-GB", "texte": "had,"},
  {"lang": "fr-FR", "texte": "suivi du participe passé. Il exprime une action qui a eu lieu avant une autre action passée."},
  {"lang": "fr-FR", "texte": "Fin du résumé. Pour vérifier que tu as retenu, essaie Interroge-moi, puis fais les exercices."}
]
